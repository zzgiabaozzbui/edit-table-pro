{
  "name": "edit-table-pro",
  "version": "0.1.1",
  "description": "High-performance editable table for React — virtual scroll, validation, undo/redo, fill handle, zero runtime dependencies",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "react",
    "table",
    "editable",
    "datagrid",
    "virtual-scroll",
    "data-entry",
    "spreadsheet",
    "undo-redo",
    "fill-handle",
    "validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzgiabaozzbui/edit-table-pro.git"
  },
  "homepage": "https://github.com/zzgiabaozzbui/edit-table-pro#readme",
  "bugs": {
    "url": "https://github.com/zzgiabaozzbui/edit-table-pro/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test -- --run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  }
}
